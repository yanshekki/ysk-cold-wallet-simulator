{
  "name": "@cws/proxy",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "bin": {
    "cws-proxy": "./src/main.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "app": "bash macos/xcode-app.sh",
    "deb": "bash linux/build-deb.sh",
    "deb:check": "bash linux/check-deb.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cws/contracts": "*",
    "@cws/native-proxy": "*",
    "@cws/protocol-ledger": "*",
    "@cws/protocol-onekey": "*",
    "@cws/protocol-qr": "*",
    "@cws/protocol-trezor": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@scure/bip39": "^1.6.0",
    "@types/node": "^24.7.2",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
